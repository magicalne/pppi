{
	"name": "pppi",
	"private": true,
	"version": "0.1.0",
	"description": "**pi — a pointer-pointer to pi. One omni agent managing your pi sessions: repos on main, worktrees as branches.",
	"type": "module",
	"packageManager": "bun@1.4.0",
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"dev:server": "bun run apps/server/src/cli.ts",
		"dev:web": "bun run --cwd apps/web dev",
		"build:web": "bun run --cwd apps/web build",
		"build": "bun run build:web",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:omni": "vitest run packages/omni",
		"test:server": "vitest run apps/server",
		"install:ext": "bun run packages/pi-ext/install.mjs"
	},
	"dependencies": {
		"typebox": "^1.3.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@earendil-works/pi-coding-agent": "0.83.0",
		"@types/node": "^24.0.1",
		"@types/qrcode": "^1.5.6",
		"@types/ws": "^8.18.1",
		"bun-types": "^1.3.12",
		"typescript": "^5.8.3",
		"vitest": "^3.2.2"
	},
	"engines": {
		"node": ">=22"
	},
	"pi": {
		"extensions": ["./packages/pi-ext/src/index.ts"]
	}
}

{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"moduleDetection": "force",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"strict": true,
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": false,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": {
			"@sspi/protocol": ["packages/protocol/src/index.ts"],
			"@sspi/omni": ["packages/omni/src/extension.ts"]
		},
		"types": ["bun-types", "node", "vitest/globals"]
	},
	"include": [
		"apps/server/**/*.ts",
		"apps/web/src/**/*.ts",
		"apps/web/src/**/*.tsx",
		"packages/**/*.ts",
		"extensions/**/*.ts",
		"tests/**/*.ts"
	]
}
